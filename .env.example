# Copy this file to .env and fill in your own values.
# Never commit .env to git - it holds your secret keys.

# ---------------- Gmail ----------------
# Which emails should give you an alert. You can change these any time
# (edit this file and restart the program).
#
# WATCH_SENDER: sender address(es) to watch. Use commas for more than one.
# A whole domain works too: @company.com
#   Examples: careers@example.edu
#             hr@company.com,@college.edu
WATCH_SENDER=careers@example.edu
# WATCH_QUERY (optional): any normal Gmail search, added on top of WATCH_SENDER.
# You can also leave WATCH_SENDER empty and use only this.
#   Examples: subject:(interview OR deadline OR "last date")
#             label:important
#             from:bank.com subject:due
WATCH_QUERY=
# OAuth client file downloaded from Google Cloud (keep it secret).
GMAIL_CREDENTIALS_FILE=credentials.json
# Created automatically after your first Google login (keep it secret).
GMAIL_TOKEN_FILE=token.json
# How far back (in hours) to look for mail from the sender. On the very first
# run, emails from this window get alerts too. Already-seen emails are never
# alerted twice, even after a restart.
LOOKBACK_HOURS=24

# ---------------- AI that reads the email ----------------
# Which AI writes the summary and finds the deadline:
#   gemini = Google Gemini, has a FREE tier (key from https://aistudio.google.com/apikey)
#   claude = Anthropic Claude, pay as you go
AI_PROVIDER=gemini

# Gemini (when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (when AI_PROVIDER=claude). Key from https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Model used to read the email. Haiku is the fast and cheap one.
CLAUDE_MODEL=claude-haiku-5-5

# ---------------- Twilio ----------------
# Set to false to only get calls, no WhatsApp (for example on a Twilio
# "Limited trial" account, which blocks custom WhatsApp text).
WHATSAPP_ENABLED=true
# From the Twilio Console home page.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sender. For the sandbox this is whatsapp:+14155238886.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own WhatsApp number in international format (change any time).
MY_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
# A voice-capable Twilio phone number (the one Twilio gave you).
TWILIO_VOICE_FROM=+1XXXXXXXXXX
# Your own phone number that should be called (change any time).
MY_PHONE_NUMBER=+91XXXXXXXXXX

# Optional: approved WhatsApp template (production only). Leave empty to send
# free-form text (works in the sandbox inside the 24 hour window).
TWILIO_CONTENT_SID=
# Optional: which alert field goes into each template placeholder, as JSON.
# Allowed fields: summary, topic, action, deadline, subject, sender
TWILIO_CONTENT_VARIABLES={"1": "summary", "2": "deadline", "3": "action"}

# Voice used for the phone call. Polly.Aditi is an Indian English voice.
TWILIO_VOICE=Polly.Aditi
TWILIO_VOICE_LANGUAGE=en-IN

# Only for Twilio "Limited trial" accounts, which block custom speech on calls.
# Set this to a Twilio voice URL and the phone will still ring, but it won't
# read the alert aloud. Leave EMPTY on a normal (upgraded) account.
#   Example: TWILIO_CALL_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_speech_recognition
TWILIO_CALL_URL=

# Title shown at the top of the WhatsApp message and spoken on the call.
#   Examples: Email alert, Placement alert, Job alert, Bill alert
ALERT_TITLE=Email alert

# ---------------- Timing ----------------
# How often (seconds) to check Gmail and WhatsApp read status.
POLL_SECONDS=60
# When an email has no deadline, call after this many minutes if still unread.
NO_DEADLINE_CALL_MINUTES=60
# All times are shown and calculated in this timezone.
TIMEZONE=Asia/Kolkata

# ---------------- Storage and logs ----------------
DB_PATH=data/alerts.db
LOG_FILE=logs/app.log
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
